# ==============================================================================
# chatw - Configuration Reference (.env.example)
# ==============================================================================

# Database
# PostgreSQL connection string. Default port for local docker-compose is 55432.
DATABASE_URL=postgres://chatw:chatw_dev_password@127.0.0.1:55432/chatw
DB_MAX_CONNECTIONS=10

# Server Bind Address
BIND_ADDR=127.0.0.1:8080

# Public Origin (Must match exact browser origin: scheme + domain + port, no trailing slash)
# For local development: http://localhost:8080 or http://127.0.0.1:8080
PUBLIC_URL=http://localhost:8080

# Google OAuth 2.0 / OpenID Connect credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI must be: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override; defaults to ${PUBLIC_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Security & Session
# Minimum 32 characters high-entropy random string used to HMAC session tokens and state cookies.
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long-random-string

# Session Time-To-Live in hours (default: 168 hours = 7 days)
SESSION_TTL_HOURS=168

# Static frontend assets directory (when serving production build via Rust Axum)
STATIC_DIR=../frontend/dist

# Connection limits
MAX_WS_CONNECTIONS=5000
TRUST_PROXY=false

# Local development only: enables passwordless "quick login" (POST /api/auth/dev-login).
# The server refuses to start if this is true and PUBLIC_URL is not a loopback origin.
DEV_LOGIN=false
