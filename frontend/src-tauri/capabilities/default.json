{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (bundled launcher page and local backend origin)",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:8085/*",
      "http://127.0.0.1:8085/*",
      "http://localhost:8082/*",
      "http://127.0.0.1:8082/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
